# Copia a .env en la raiz. Nunca publiques el archivo .env.
DATABASE_URL=postgresql://minetrack:minetrack@localhost:5432/minetrack
PORT=3000
FRONTEND_URL=http://localhost:5173
# Para Vite en local, pon VITE_API_URL tambien en frontend/.env.local
VITE_API_URL=http://localhost:3000
# Solo para npm run deploy (Render > Account Settings > API Keys)
RENDER_API_KEY=
RENDER_BACKEND_SERVICE_ID=
RENDER_FRONTEND_SERVICE_ID=
BACKEND_URL=
FRONTEND_PUBLIC_URL=
# DATABASE_URL debe ser la conexion EXTERNA de Render al desplegar desde tu PC.
# PostgreSQL remoto: agrega ?sslmode=require a su URL si el proveedor lo requiere.
DEPLOY_TIMEOUT_SECONDS=1200
